<http://example.org/tdm/video/video7610#t=0.00,3.00> a ma:MediaFragment ;
    tdm:endTime 3.0 ;
    tdm:fragmentKind "speech" ;
    tdm:startTime 0.0 ;
    tdm:text "So let's talk about another force, gravity."@en ;
    ma:isFragmentOf video:video7610 .

<http://example.org/tdm/video/video7610#t=11.00,12.00> a ma:MediaFragment ;
    tdm:endTime 12.0 ;
    tdm:fragmentKind "speech" ;
    tdm:startTime 11.0 ;
    tdm:text "It's a pull."@en ;
    ma:isFragmentOf video:video7610 .

<http://example.org/tdm/video/video7610#t=12.00,20.00> a ma:MediaFragment ;
    tdm:endTime 20.0 ;
    tdm:fragmentKind "speech" ;
    tdm:startTime 12.0 ;
    tdm:text "Gravity is a force that pulls objects together because of their mass."@en ;
    ma:isFragmentOf video:video7610 .

<http://example.org/tdm/video/video7610#t=20.00,24.00> a ma:MediaFragment ;
    tdm:endTime 24.0 ;
    tdm:fragmentKind "speech" ;
    tdm:startTime 20.0 ;
    tdm:text "Any object with mass has gravity."@en ;
    ma:isFragmentOf video:video7610 .

<http://example.org/tdm/video/video7610#t=24.00,29.00> a ma:MediaFragment ;
    tdm:endTime 29.0 ;
    tdm:fragmentKind "speech" ;
    tdm:startTime 24.0 ;
    tdm:text "Here this gentleman is fighting gravity to lift these very massive weight plate."@en ;
    ma:isFragmentOf video:video7610 .

<http://example.org/tdm/video/video7610#t=3.00,5.00> a ma:MediaFragment ;
    tdm:endTime 5.0 ;
    tdm:fragmentKind "speech" ;
    tdm:startTime 3.0 ;
    tdm:text "Okay, we all know about gravity."@en ;
    ma:isFragmentOf video:video7610 .

<http://example.org/tdm/video/video7610#t=5.00,7.00> a ma:MediaFragment ;
    tdm:endTime 7.0 ;
    tdm:fragmentKind "speech" ;
    tdm:startTime 5.0 ;
    tdm:text "We all know it's a major force in our lives."@en ;
    ma:isFragmentOf video:video7610 .

<http://example.org/tdm/video/video7610#t=7.00,11.00> a ma:MediaFragment ;
    tdm:endTime 11.0 ;
    tdm:fragmentKind "speech" ;
    tdm:startTime 7.0 ;
    tdm:text "And gravity is a force that, it's an attractive force."@en ;
    ma:isFragmentOf video:video7610 .

